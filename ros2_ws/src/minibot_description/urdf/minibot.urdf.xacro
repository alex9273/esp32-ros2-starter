<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="minibot">
  <!-- Change these to match your build. Everything else follows from them. -->
  <xacro:arg name="use_sim" default="true"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:property name="chassis_length" value="0.20"/>
  <xacro:property name="chassis_width" value="0.15"/>
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="chassis_mass" value="0.6"/>
  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <!-- Distance between the two wheel centres. Must match wheel_separation in the controller config. -->
  <xacro:property name="wheel_separation" value="0.17"/>
  <xacro:property name="wheel_offset_x" value="0.05"/>
  <xacro:property name="caster_radius" value="0.0125"/>

  <xacro:include filename="$(find minibot_description)/urdf/inertia.xacro"/>
  <xacro:include filename="$(find minibot_description)/urdf/ros2_control.xacro"/>

  <link name="base_link"/>

  <!-- Footprint on the ground, used by Nav2 -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}"/>
  </joint>
  <link name="base_footprint"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${-wheel_offset_x} 0 0"/>
  </joint>
  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="orange"><color rgba="1 0.5 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}" ox="0" oy="0" oz="${chassis_height/2}"/>
  </link>

  <xacro:macro name="wheel" params="side reflect">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${reflect*wheel_separation/2} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${side}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <gazebo reference="${side}_wheel">
      <collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- Frictionless caster at the back -->
  <joint name="caster_joint" type="fixed">
    <parent link="chassis"/>
    <child link="caster"/>
    <origin xyz="${-chassis_length/2 + caster_radius*2} 0 ${caster_radius - wheel_radius}"/>
  </joint>
  <link name="caster">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <xacro:sphere_inertia m="0.01" r="${caster_radius}"/>
  </link>
  <gazebo reference="caster">
    <collision><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
  </gazebo>

  <xacro:minibot_ros2_control use_sim="$(arg use_sim)" controllers_file="$(arg controllers_file)"/>
</robot>
